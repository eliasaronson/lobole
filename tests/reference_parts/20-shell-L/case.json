{
  "title": "L prism 60×40, legs 8, 20 high, shelled 2, top open",
  "exercises": "Shell of a non-convex prism: the offset is sharp in at the convex corners and rounds about the reflex one",
  "steps": [
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "L",
          "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [0, 0], "b": [60, 0]},
            {"type": "line", "id": 2, "a": [60, 0], "b": [60, 8]},
            {"type": "line", "id": 3, "a": [60, 8], "b": [8, 8]},
            {"type": "line", "id": 4, "a": [8, 8], "b": [8, 40]},
            {"type": "line", "id": 5, "a": [8, 40], "b": [0, 40]},
            {"type": "line", "id": 6, "a": [0, 40], "b": [0, 0]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Extrude",
          "name": "L",
          "sketch_id": {"$ref": 1},
          "distance": 20,
          "mode": "new_body"
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Shell",
          "name": "Shell",
          "body_id": {"$ref": 2},
          "thickness": 2,
          "open_faces": [{"$pick": "face", "at": [4, 4, 20]}]
        }
      }
    }
  ]
}

{
  "title": "Closed L loop, thin 2 centred, extruded 15",
  "exercises": "Extrude `thin` with `side: both`: the wall ring's joins, round outside the convex corners and about the reflex one inside",
  "steps": [
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Angle",
          "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [0, 0], "b": [40, 0]},
            {"type": "line", "id": 2, "a": [40, 0], "b": [40, 10]},
            {"type": "line", "id": 3, "a": [40, 10], "b": [10, 10]},
            {"type": "line", "id": 4, "a": [10, 10], "b": [10, 30]},
            {"type": "line", "id": 5, "a": [10, 30], "b": [0, 30]},
            {"type": "line", "id": 6, "a": [0, 30], "b": [0, 0]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Extrude",
          "name": "Wall",
          "sketch_id": {"$ref": 1},
          "distance": 15,
          "mode": "new_body",
          "thin": {"thickness": 2, "side": "both"}
        }
      }
    }
  ]
}

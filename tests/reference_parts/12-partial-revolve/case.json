{
  "title": "Square r 4..12, z 0..8 revolved 270°",
  "exercises": "a partial Revolve: its sweep direction (right-handed about +z) and its end caps",
  "steps": [
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Section",
          "plane": {"origin": [0, 0, 0], "normal": [0, -1, 0], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [4, 0], "b": [12, 0]},
            {"type": "line", "id": 2, "a": [12, 0], "b": [12, 8]},
            {"type": "line", "id": 3, "a": [12, 8], "b": [4, 8]},
            {"type": "line", "id": 4, "a": [4, 8], "b": [4, 0]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Revolve",
          "name": "Sector",
          "sketch_id": {"$ref": 1},
          "axis": {"kind": "z"},
          "angle_deg": 270,
          "mode": "new_body"
        }
      }
    }
  ]
}

{
  "title": "Block with one boss mirrored across YZ",
  "exercises": "a mirror Pattern of an add extrude",
  "steps": [
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Box",
          "name": "Block",
          "on": "Top",
          "width": 80,
          "depth": 40,
          "height": 10
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Boss",
          "plane": {"origin": [0, 0, 10], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [{"type": "circle", "id": 1, "center": [25, 5], "radius": 6}]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Extrude",
          "name": "Boss",
          "sketch_id": {"$ref": 2},
          "distance": 15,
          "mode": "add"
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Pattern",
          "name": "Mirror",
          "kind": "mirror",
          "source_id": {"$ref": 3},
          "base_plane": "yz"
        }
      }
    }
  ]
}

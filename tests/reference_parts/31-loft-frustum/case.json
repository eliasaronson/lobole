{
  "title": "Loft from a square 40 at z0 to a square 20 at z30",
  "exercises": "Loft between two parallel similar sections",
  "steps": [
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Base",
          "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [-20, -20], "b": [20, -20]},
            {"type": "line", "id": 2, "a": [20, -20], "b": [20, 20]},
            {"type": "line", "id": 3, "a": [20, 20], "b": [-20, 20]},
            {"type": "line", "id": 4, "a": [-20, 20], "b": [-20, -20]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Top",
          "plane": {"origin": [0, 0, 30], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [-10, -10], "b": [10, -10]},
            {"type": "line", "id": 2, "a": [10, -10], "b": [10, 10]},
            {"type": "line", "id": 3, "a": [10, 10], "b": [-10, 10]},
            {"type": "line", "id": 4, "a": [-10, 10], "b": [-10, -10]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Loft",
          "name": "Frustum",
          "sketch_ids": [{"$ref": 1}, {"$ref": 2}],
          "mode": "new_body"
        }
      }
    }
  ]
}

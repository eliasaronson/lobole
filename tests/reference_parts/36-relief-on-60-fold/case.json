{
  "title": "Two 60° flanges meeting at a corner, circular relief, laid flat",
  "exercises": "CornerRelief `circular` where two folds that are not square meet, then FlatPattern",
  "compare": ["bodies", "bbox"],
  "steps": [
    {
      "method": "set_sheet_metal_rules",
      "params": {
        "material": "aluminum_6061_t6",
        "gauge": "1.5mm",
        "bend_radius_mm": 3,
        "k_factor": 0.41
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Blank",
          "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [0, 0], "b": [100, 0]},
            {"type": "line", "id": 2, "a": [100, 0], "b": [100, 60]},
            {"type": "line", "id": 3, "a": [100, 60], "b": [0, 60]},
            {"type": "line", "id": 4, "a": [0, 60], "b": [0, 0]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {"type": "BaseFlange", "name": "Base", "sketch_id": {"$ref": 2}}
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "EdgeFlange",
          "name": "Walls",
          "length": 15,
          "angle_deg": 60,
          "edges": [
            {"$pick": "edge", "at": [100, 30, 1.5]},
            {"$pick": "edge", "at": [50, 60, 1.5]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "CornerRelief",
          "name": "Relief",
          "body_id": {"$ref": 3},
          "style": "circular"
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {"type": "FlatPattern", "name": "Flat", "body_id": {"$ref": 3}}
      }
    }
  ]
}

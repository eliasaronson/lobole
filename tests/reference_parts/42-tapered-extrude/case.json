{
  "title": "Square 20 extruded 10, tapered 15°",
  "exercises": "Extrude `taper_deg`: every wall drafted about the sketch plane",
  "compare": ["bodies", "volume", "area", "center_of_mass", "bbox", "faces"],
  "steps": [
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Sketch",
          "name": "Square",
          "plane": {"origin": [0, 0, 0], "normal": [0, 0, 1], "uAxis": [1, 0, 0]},
          "entities": [
            {"type": "line", "id": 1, "a": [-10, -10], "b": [10, -10]},
            {"type": "line", "id": 2, "a": [10, -10], "b": [10, 10]},
            {"type": "line", "id": 3, "a": [10, 10], "b": [-10, 10]},
            {"type": "line", "id": 4, "a": [-10, 10], "b": [-10, -10]}
          ]
        }
      }
    },
    {
      "method": "add_feature",
      "params": {
        "feature": {
          "type": "Extrude",
          "name": "Taper",
          "sketch_id": {"$ref": 1},
          "distance": 10,
          "taper_deg": 15,
          "mode": "new_body"
        }
      }
    }
  ]
}

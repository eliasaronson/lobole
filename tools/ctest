#!/usr/bin/env bash
# ctest, holding the build directory's lock shared: the one way to run a suite.
#
#   tools/ctest -LE gui -j8                  # in build/
#   tools/ctest -L cam                       # a tag is a label
#   tools/ctest --test-dir build-asan -LE gui
#
# Every argument is ctest's. A build or a merge takes the same lock
# exclusively (tools/build.sh, tools/merge-branch.sh), so neither relinks
# designer_tests under a running suite, and two suites still run side by side
# (tools/build-lock.sh). It runs in shell.nix's environment (tools/nix-run)
# when it is not already in one.
#
# It refuses to run when the app or a test binary is older than a file it is
# built from (tools/stale-binaries.sh): build first.
#
# The job count is taken down to the CPUs OTHER work leaves free
# (docs/ui/testing.md#a-suite-on-a-busy-machine): `-j22` on a machine where
# another worktree's build keeps 16 busy runs `-j6`, and says so. The
# TIMEOUTs are wall-clock hang guards, sized for a test that has a CPU; a
# suite started at -j$(nproc) beside someone else's build gave every test a
# third of one, and five tests that pass alone in seconds timed out
# (refused_calls_smoke, fuzz_seeds_smoke, the reader fuzz, packaging_smoke,
# the adaptive pocket). Never below a quarter of the count asked. Measured once, at the start, over a second of
# /proc/stat -- the load average lags by a minute and counts a build that
# just ended -- and against what other builds and suites have CLAIMED
# (tools/cpu-claims.sh), which counts one that started a second ago and is
# not busy yet. LOBOLE_CTEST_JOBS=asked keeps the count as given.
#
# --test-dir is resolved here (against the cwd, then the repo root) and
# handed to ctest as that ABSOLUTE path in place of the one given: ctest
# runs from inside the build directory, where a relative --test-dir would
# name build/build.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dir="$root/build"
rest=()
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --test-dir)
      dir="${args[i + 1]:-}"
      i=$((i + 1))
      ;;
    --test-dir=*) dir="${args[i]#--test-dir=}" ;;
    *) rest+=("${args[i]}") ;;
  esac
done
[ -d "$dir" ] || [ ! -d "$root/$dir" ] || dir="$root/$dir"
[ -d "$dir" ] || { echo "ctest: no build directory $dir" >&2; exit 2; }
dir="$(cd "$dir" && pwd)"
# The GPU lock tools/xvfb-exec.sh takes per test, taken here for the whole run
# when a selected test goes through it, BEFORE ctest's clock starts: queued
# behind another worktree's GUI suite, remote_smoke spent 9.5 of its 600 s
# waiting inside xvfb-exec, and the timeout killed its display 24 s into the
# real run. Taken before build/'s lock, as gui-tests-xvfb.sh does, so a run
# waiting here does not hold up a merge.
selected() {
  local q=""
  for a in ${rest[@]+"${rest[@]}"}; do q+=" $(printf '%q' "$a")"; done
  if ! command -v nix-instantiate >/dev/null; then
    (cd "$dir" && eval "ctest -N --show-only=json-v1$q")
  else
    "$root/tools/nix-run" "cd $(printf '%q' "$dir") && ctest -N --show-only=json-v1$q"
  fi
}
if [ "${LOBOLE_GUI_LOCKED:-}" != "1" ] &&
  selected 2>/dev/null | grep -q 'xvfb-exec\.sh'; then
  exec 7>/tmp/designer-gui-gpu.lock
  if ! flock -n 7; then
    echo "ctest: waiting for the GPU lock (another GUI suite is running)" >&2
    flock 7
  fi
  export LOBOLE_GUI_LOCKED=1
fi
# shellcheck source=build-lock.sh
. "$root/tools/build-lock.sh"
build_lock_shared "$dir" 9
# A binary behind its source would test the code it was linked from, not this
# tree's (tools/stale-binaries.sh). Asked under the lock, so a build that is
# running finishes first.
if ! command -v nix-instantiate >/dev/null; then
  behind="$("$root/tools/stale-binaries.sh" "$dir")" || true
else
  behind="$("$root/tools/nix-run" "$(printf '%q %q' "$root/tools/stale-binaries.sh" "$dir")")" || true
fi
if [ -n "$behind" ]; then
  echo "$behind" | sed 's/^/ctest: /' >&2
  echo "ctest: build first: tools/build.sh $(printf '%q' "$dir")" >&2
  exit 2
fi
# CPUs other work holds: busy over the last second, or claimed by another
# build or suite that has started but is not busy yet (tools/cpu-claims.sh).
# shellcheck source=cpu-claims.sh
. "$root/tools/cpu-claims.sh"
jobs_at=-1 jobs=""
for ((i = 0; i < ${#rest[@]}; i++)); do
  case "${rest[i]}" in
    -j[0-9]*) jobs_at=$i jobs="${rest[i]#-j}" ;;
    --parallel=*) jobs_at=$i jobs="${rest[i]#--parallel=}" ;;
    -j | --parallel)
      if [[ "${rest[i + 1]:-}" =~ ^[0-9]+$ ]]; then
        rest[i]="-j${rest[i + 1]}"
        unset 'rest[i + 1]'
        rest=("${rest[@]}")
        jobs_at=$i jobs="${rest[i]#-j}"
      fi
      ;;
  esac
done
if [ "$jobs_at" -ge 0 ] && [ "${jobs:-1}" -gt 1 ] &&
  [ "${LOBOLE_CTEST_JOBS:-}" != "asked" ] && [ -r /proc/stat ]; then
  cpus="$(nproc)"
  free="$(free_cpus)"
  # A floor of a quarter of what was asked: past that the suite would
  # crawl for a load that may be gone in a minute, and on a machine
  # whose other work alone fills it, fewer jobs of ours buy little.
  floor=$(((jobs + 3) / 4))
  [ "$free" -ge "$floor" ] || free=$floor
  if [ "$free" -lt "$jobs" ]; then
    echo "ctest: -j$jobs -> -j$free: $((cpus - free)) of $cpus CPUs are busy" \
      "or claimed by other builds and suites (LOBOLE_CTEST_JOBS=asked keeps -j$jobs)" >&2
    rest[jobs_at]="-j$free"
    jobs=$free
  fi
fi
# What this run holds, so a suite or build started a second later sizes
# itself around it rather than around an idle machine.
[ "$jobs_at" -ge 0 ] && cpu_claim "${jobs:-1}"
quoted=" --test-dir $(printf '%q' "$dir")"
for a in ${rest[@]+"${rest[@]}"}; do quoted+=" $(printf '%q' "$a")"; done
# A run that passes on a committed tree is stamped with that tree and the
# toolchain (tools/suite_stamp.py), so tools/merge-branch.sh need not run it
# again on main when main's tree after the pick is this one. The tree is
# read before and after: a commit or an edit during the run stamps nothing.
tree0=""
if git -C "$root" rev-parse --git-dir >/dev/null 2>&1 &&
   python3 "$root/tools/suite_stamp.py" clean "$root" 2>/dev/null; then
  tree0="$(git -C "$root" rev-parse 'HEAD^{tree}')"
fi
# The fd is closed for the run: a process a test leaves behind must not keep
# holding the lock. This shell holds it until ctest returns. On a machine
# without nix (CI), ctest is the one on PATH. IN_NIX_SHELL is not trusted: an
# agent's session sits in a nix-shell that is not shell.nix's (no ccx), and
# every CalculiX test skipped there without a word.
status=0
if ! command -v nix-instantiate >/dev/null; then
  (cd "$dir" && eval "ctest$quoted") 9>&- 7>&- || status=$?
else
  "$root/tools/nix-run" "cd $(printf '%q' "$dir") && ctest$quoted" 9>&- 7>&- || status=$?
fi
if [ -n "$tree0" ]; then
  if [ "$status" -ne 0 ]; then
    python3 "$root/tools/suite_stamp.py" forget "$dir" "$tree0" ${rest[@]+"${rest[@]}"} || true
  elif python3 "$root/tools/suite_stamp.py" clean "$root" 2>/dev/null &&
       [ "$(git -C "$root" rev-parse 'HEAD^{tree}')" = "$tree0" ]; then
    python3 "$root/tools/suite_stamp.py" write "$dir" "$tree0" ${rest[@]+"${rest[@]}"} || true
  fi
fi
exit "$status"

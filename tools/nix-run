#!/usr/bin/env bash
# Run a command in shell.nix's environment, without entering nix-shell.
#
#   tools/nix-run 'cd build && ninja designer'
#
# Entering nix-shell costs ~5 s, every time; a round of work entered it about
# 400 times (docs/architecture.md#the-development-loop). This sources the same environment from a
# cache of what `nix-shell shell.nix` adds to the environment, in ~0.01 s. The cache is keyed on
# shell.nix and the nixpkgs it resolves, so either moving makes a new one, and
# it is remade if a garbage collection took a store path it points at.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dir="$root/.nix-env"
mkdir -p "$dir"
nixpkgs="$(nix-instantiate --find-file nixpkgs 2>/dev/null || echo none)"
# FORMAT versions what the cache holds: a file written by an older nix-run
# (the whole environment, DISPLAY and TMPDIR frozen in) must not be read.
# 3: the environment is captured from a clean one, not this shell's.
FORMAT=3
key="$( { sha256sum "$root/shell.nix"; echo "$nixpkgs"; echo "format $FORMAT"; } | sha256sum | cut -c1-16)"
env="$dir/$key.sh"
alive() { # every store path on the cached PATH still exists
  local p
  for p in $(sed -n "s/^export PATH='\\(.*\\)'\$/\\1/p" "$env" | tr ':' ' '); do
    case "$p" in /nix/store/*) [ -e "$p" ] || return 1 ;; esac
  done
}
if [ ! -s "$env" ] || ! alive; then
  tmp="$(mktemp "$dir/.new.XXXXXX")"
  # What nix-shell ADDS to this environment, and nothing else: its own
  # variables, captured inside and diffed against outside. Not `nix
  # print-dev-env` (it resolved a different nixpkgs here: fmt 12.2 and its
  # spdlog against nix-shell's 12.1, and a binary linked through it loaded one
  # and the other). Not the whole `export -p` either: that froze DISPLAY (an
  # xvfb-run display would be overwritten) and TMPDIR (a directory the
  # generating nix-shell deleted on exit).
  #
  # Both sides start from a CLEAN environment, not this one. nix-shell
  # appends to the search paths it inherits, so run from inside another
  # nix-shell (an agent's session is one) the capture carried that shell's
  # NIX_LDFLAGS and CMAKE prefixes along: a tree whose shell.nix patched
  # OpenCASCADE configured against the outer shell's stock one, and linked
  # it. PATH keeps what is not in the store, so ~/bin and the system's stay.
  outer="$(mktemp)"; inner="$(mktemp)"
  basepath="$(tr ':' '\n' <<<"$PATH" | grep -v '^/nix/store/' | paste -sd: -)"
  clean=(env -i HOME="$HOME" USER="${USER:-}" LOGNAME="${LOGNAME:-}"
         TERM="${TERM:-dumb}" PATH="$basepath")
  [ -n "${NIX_PATH:-}" ] && clean+=(NIX_PATH="$NIX_PATH")
  [ -n "${NIX_REMOTE:-}" ] && clean+=(NIX_REMOTE="$NIX_REMOTE")
  "${clean[@]}" env -0 > "$outer"
  (cd "$root" && "${clean[@]}" nix-shell shell.nix --run 'env -0') > "$inner"
  python3 - "$outer" "$inner" > "$tmp" <<'PY'
import shlex, sys
def load(p):
    out = {}
    for item in open(p, 'rb').read().split(b'\0'):
        if b'=' in item:
            k, v = item.split(b'=', 1)
            out[k.decode()] = v.decode(errors='surrogateescape')
    return out
outer, inner = load(sys.argv[1]), load(sys.argv[2])
skip = {'TMPDIR', 'TMP', 'TEMP', 'TEMPDIR', 'NIX_BUILD_TOP', 'PWD', 'OLDPWD',
        'SHLVL', '_', 'DISPLAY', 'WAYLAND_DISPLAY', 'XAUTHORITY'}
for k in sorted(inner):
    if k in skip or not k.replace('_', 'a').isalnum() or inner[k] == outer.get(k):
        continue
    print(f'export {k}={shlex.quote(inner[k])}')
PY
  rm -f "$outer" "$inner"
  mv "$tmp" "$env"
  find "$dir" -name '*.sh' ! -name "$key.sh" -delete 2>/dev/null || true
fi
exec bash -c 'source "$1" >/dev/null 2>&1; shift; eval "$*"' _ "$env" "$@"

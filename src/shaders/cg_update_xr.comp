#version 450
// The PCG step update with alpha computed in-kernel from the on-device
// scalars (no CPU round trip): alpha = rz / pAp; x += alpha p; r -= alpha Ap.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer VecP { float p[]; };
layout(std430, binding = 1) readonly buffer VecAp { float Ap[]; };
layout(std430, binding = 2) buffer VecX { float x[]; };
layout(std430, binding = 3) buffer VecR { float r[]; };
layout(std430, binding = 4) readonly buffer Scalars { float s[]; };

layout(push_constant) uniform Push {
  uint n;
  uint rzSlot;
  uint pApSlot;
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  const float alpha = s[pc.rzSlot] / s[pc.pApSlot];
  x[i] += alpha * p[i];
  r[i] -= alpha * Ap[i];
}

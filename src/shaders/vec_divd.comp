#version 450
// dst = src / diag — one power-iteration application step (w = D^-1 K v uses
// the SpMV for K v, then this).

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) readonly buffer Diag { float diagK[]; };
layout(std430, binding = 2) writeonly buffer Dst { float dst[]; };

layout(push_constant) uniform Push { uint n; } pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  dst[i] = src[i] / diagK[i];
}

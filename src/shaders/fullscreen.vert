#version 450

// Fullscreen triangle from gl_VertexIndex — no vertex buffer. The triangle
// overshoots the viewport; uv is [0,1] across the visible region.
layout(location = 0) out vec2 fragUV;

void main() {
    fragUV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
    gl_Position = vec4(fragUV * 2.0 - 1.0, 0.0, 1.0);
}

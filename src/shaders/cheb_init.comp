#version 450
// Chebyshev preconditioner init (GPU2, Saad Alg. 12.1 on A = D^-1 K):
// inner residual rc = b = D^-1 r, first correction d = b/theta, z = d.
// All Chebyshev coefficients are host-computed push constants — the inner
// loop has no reductions at all.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer VecR { float r[]; };
layout(std430, binding = 1) readonly buffer Diag { float diagK[]; };
layout(std430, binding = 2) writeonly buffer ChebR { float rc[]; };
layout(std430, binding = 3) writeonly buffer ChebD { float d[]; };
layout(std430, binding = 4) writeonly buffer VecZ { float z[]; };

layout(push_constant) uniform Push {
  uint n;
  float invTheta;
} pc;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) return;
  const float b = r[i] / diagK[i];
  rc[i] = b;
  const float d0 = b * pc.invTheta;
  d[i] = d0;
  z[i] = d0;
}

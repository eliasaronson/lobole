#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference2 : require

// Section cuts for the path-traced still.
//
// The raster passes discard a FRAGMENT past a clip plane (mesh.frag and
// friends, all reading ui::SectionPlanes through ClipPlanes.h). A ray tracer
// cannot do that in closest-hit: by then traversal has already committed to
// the nearest surface, and rejecting it there would leave a hole rather than
// reveal what is behind it. Any-hit is the stage that can — ignoring an
// intersection lets traversal carry on and find the next surface along the
// ray, which is exactly what a cut-open view is.
//
// Same rule as ClipPlanes.h so a ray and a fragment agree to the letter:
// removed where dot(n, p) > w for ANY live plane.

layout(binding = 2, set = 0) uniform UniformBufferObject {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 viewPos;
    vec4 lightDir;
    vec4 lightColor;
    vec4 ambientColor;
    vec4 params;
    vec4 fillDir;
    vec4 fillColor;
    vec4 rimDir;
    vec4 rimColor;
    // Section planes; a hit is removed where dot(n, p) > w. clipInfo.x is how
    // many are live, so a scene with no section costs one compare per ray.
    vec4 clipPlanes[4];
    vec4 clipInfo;
} ubo;

// Glass lets a SHADOW ray through (docs/rendering/materials.md#glass). Every ray
// traced through this hit group carries a RayPayload, camera or shadow, so
// the incoming payload is the same type whichever it is.
struct RayPayload {
    vec3 radiance;
    uint rngState;
    vec3 gnormal;
    float hitT;   // < 0.0 on a miss
    uint instId;  // 0 = miss or shadow catcher, else geometry index + 1
    // A path through glass (docs/rendering/materials.md#glass): closest-hit sets
    // kFlagContinue and the next ray, and raygen's loop traces it, weighting
    // what it finds by `throughput`. SHADOW rays carry this payload too, so
    // the one hit group's any-hit can read it: then radiance is the ray's
    // transmittance and kFlagBlocked says something opaque was in the way.
    // Identical in raygen, closesthit, miss, shadow.rmiss and section.rahit.
    uint flags;
    vec3 throughput;
    vec3 nextOrigin;
    vec3 nextDir;
};
const uint kFlagContinue = 1u;
const uint kFlagReflected = 2u; // the path has reflected: miss shows the HDRI
const uint kFlagBlocked = 4u;
rayPayloadInEXT RayPayload hit;

struct Material {
    vec3 baseColor;
    float metallic;
    vec3 emissive;
    float roughness;
    vec3 specular;
    float transmission;
    vec4 procParams;
    vec4 optics; // x = index of refraction
};
layout(binding = 4, set = 0, std430) readonly buffer Materials {
    Material materials[];
};

// Geometry flags, to spare the backdrop below. Must match closesthit.rchit.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer FloatBuf { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer UintBuf { uint u[]; };
const uint kFlagShadowCatcher = 1u;
const uint kFlagPerTriangleMaterial = 2u;
struct GeometryInfo {
    FloatBuf verts;
    UintBuf inds;
    uint materialIndex;
    uint flags;
    // One material index per triangle, read only under
    // kFlagPerTriangleMaterial (faces with looks of their own, v164).
    UintBuf triMats;
};
layout(binding = 3, set = 0, std430) readonly buffer GeometryInfos {
    GeometryInfo geoms[];
};

void main() {
    GeometryInfo g = geoms[gl_InstanceCustomIndexEXT];

    // The ground is scenery, not model. Cutting it leaves the shadow catcher
    // ending in mid-air at the plane, with the backdrop showing through the
    // gap — a section through the part should not saw the floor in half.
    int live = int(ubo.clipInfo.x + 0.5);
    if (live > 0 && (g.flags & kFlagShadowCatcher) == 0u) {
        vec3 p = gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT;
        for (int i = 0; i < live; i++) {
            vec4 pl = ubo.clipPlanes[i];
            if (dot(pl.xyz, p) > pl.w) {
                ignoreIntersectionEXT;
            }
        }
    }

    // A shadow or AO ray (the only rays that skip closest-hit) passes through
    // glass, losing the pane's tint and the reflected share at each surface.
    // A camera or path ray still STOPS on glass: closest-hit's dielectric
    // branch is what refracts it.
    if ((gl_IncomingRayFlagsEXT & gl_RayFlagsSkipClosestHitShaderEXT) != 0u) {
        Material m = materials[(g.flags & kFlagPerTriangleMaterial) != 0u
                                   ? g.triMats.u[gl_PrimitiveID]
                                   : g.materialIndex];
        if (m.transmission > 0.0) {
            float ior = max(m.optics.x, 1.0);
            float f0 = (ior - 1.0) / (ior + 1.0);
            hit.radiance *= m.baseColor * m.transmission * (1.0 - f0 * f0);
            ignoreIntersectionEXT;
        }
    }
}

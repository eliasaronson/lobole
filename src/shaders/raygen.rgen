#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba32f) uniform image2D image;
// Primary-hit G-buffer for the outline pass. Written by extra launches (see
// the auxPass push constant), one strip of rows at a time, at a higher
// resolution than the still so the lines come out antialiased rather than
// stair-stepped.
layout(binding = 9, set = 0, rgba32ui) uniform uimage2D auxImage;

layout(binding = 2, set = 0) uniform UniformBufferObject {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 viewPos;
    vec4 lightDir;
    vec4 lightColor;
    vec4 ambientColor;
    vec4 params;      // x = prefilter mips, y = ray far, z = AO radius
    vec4 fillDir;     // unused here; the block must match closesthit.rchit
    vec4 fillColor;
    vec4 rimDir;
    vec4 rimColor;
    // Section planes; a hit is removed where dot(n, p) > w. clipInfo.x is how
    // many are live, so a scene with no section costs one compare per ray.
    vec4 clipPlanes[4];
    vec4 clipInfo;
    // World direction -> environment-map direction (core/LightRig.h): the
    // studio turns with the camera unless the lights are locked to the model.
    mat4 envRotation;
} ubo;

// Per-sample RNG seed data (raygen only).
layout(push_constant) uniform PushConstants {
    uint sampleIndex;
    uint frameSeed;
    // 1 = the outline G-buffer launch: trace one unjittered ray through the
    // pixel centre and write auxImage instead of accumulating radiance.
    uint auxPass;
    // The G-buffer is traced in STRIPS of rows
    // (docs/rendering/still-render.md#outlines-on-a-traced-still): a launch
    // covers rows [auxRow0, auxRow0 + launch height) of an image auxHeight rows
    // tall, and writes them to the strip-sized auxImage from row 0.
    uint auxRow0;
    uint auxHeight;
} pc;

// Radiance + RNG state, plus the primary-hit G-buffer the outline pass reads.
// The viewport draws crisp edges over every body and the still drew none, so a
// row of butted deck boards came back as one continuous slab. gnormal is the
// FACE normal, not the interpolated one: a hard edge is then an exact
// discontinuity, while a finely tessellated cylinder is not.
struct RayPayload {
    vec3 radiance;
    uint rngState;
    vec3 gnormal;
    float hitT;   // < 0.0 on a miss
    uint instId;  // 0 = miss or shadow catcher, else geometry index + 1
    // A path through glass (docs/rendering/materials.md#glass): closest-hit sets
    // kFlagContinue and the next ray, and raygen's loop traces it, weighting
    // what it finds by `throughput`. SHADOW rays carry this payload too, so
    // the one hit group's any-hit can read it: then radiance is the ray's
    // transmittance and kFlagBlocked says something opaque was in the way.
    // Identical in raygen, closesthit, miss, shadow.rmiss and section.rahit.
    uint flags;
    vec3 throughput;
    vec3 nextOrigin;
    vec3 nextDir;
};
const uint kFlagContinue = 1u;
const uint kFlagReflected = 2u; // the path has reflected: miss shows the HDRI
const uint kFlagBlocked = 4u;
layout(location = 0) rayPayloadEXT RayPayload payload;

// Segments in one path: the camera ray plus glass continuations.
const int kMaxBounces = 8;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void main() {
    // Seed from BOTH pixel and sample: pixel-only seeding never decorrelates and
    // the accumulation would not converge with sample count.
    uint pixelIndex = gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
    payload.rngState =
        pcgHash(pixelIndex) ^ pcgHash(pc.sampleIndex ^ (pc.frameSeed * 9781u));

    // Sub-pixel jitter (uniform over the pixel) gives free anti-aliasing as
    // samples accumulate. The G-buffer launch takes the pixel centre instead:
    // it is a single sample and a jittered one would ripple every edge.
    payload.rngState = payload.rngState * 747796405u + 2891336453u;
    float jx = float((payload.rngState >> 8) & 0xFFFFu) / 65536.0;
    payload.rngState = payload.rngState * 747796405u + 2891336453u;
    float jy = float((payload.rngState >> 8) & 0xFFFFu) / 65536.0;
    if (pc.auxPass != 0u) { jx = 0.5; jy = 0.5; }

    vec2 pixel = vec2(gl_LaunchIDEXT.xy) + vec2(jx, jy);
    vec2 size = vec2(gl_LaunchSizeEXT.xy);
    if (pc.auxPass != 0u) {
        pixel.y += float(pc.auxRow0);
        size.y = float(pc.auxHeight);
    }
    const vec2 inUV = pixel / size;
    vec2 d = inUV * 2.0 - 1.0;

    vec4 origin = ubo.viewInverse * vec4(0, 0, 0, 1);
    vec4 target = ubo.projInverse * vec4(d.x, d.y, 1, 1);
    vec4 direction = ubo.viewInverse * vec4(normalize(target.xyz), 0);

    // params.y, not a literal: the old 10000 was a LENGTH, and the unit is
    // the model's. A 6 m dock has to be framed from ~11 m away, so every
    // primary ray missed and the still came back as pure environment.
    // OpaqueEXT SKIPS the any-hit stage, which is where section cuts are
    // applied -- with a section live the flag would render the model uncut.
    // It is kept when nothing is cut, so a scene with no section pays none of
    // the traversal cost any-hit brings.
    uint rayFlags = ubo.clipInfo.x > 0.5 ? gl_RayFlagsNoneEXT
                                         : gl_RayFlagsOpaqueEXT;

    // A path: the camera ray, then as many continuations as glass asks for
    // (closesthit.rchit's dielectric branch reflects or refracts and hands the
    // next ray back). An opaque hit or a miss ends it. Looping HERE, not
    // recursing from closest-hit, keeps the pipeline's recursion depth at 2
    // however many panes a ray crosses.
    vec3 rayOrigin = origin.xyz;
    vec3 rayDir = direction.xyz;
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);
    payload.flags = 0u;
    for (int bounce = 0; bounce < kMaxBounces; ++bounce) {
        payload.radiance = vec3(0.0);
        payload.flags &= ~kFlagContinue;
        traceRayEXT(topLevelAS, rayFlags, 0xff, 0, 0, 0, rayOrigin,
                    0.001, rayDir, ubo.params.y, 0);

        if (bounce == 0 && pc.auxPass != 0u) {
            // Face normal at half precision (ample for a 60-degree
            // threshold), hit distance, and the id that separates one body
            // from the next -- of the FIRST hit, glass or not.
            uvec4 aux;
            aux.x = packHalf2x16(payload.gnormal.xy);
            aux.y = packHalf2x16(vec2(payload.gnormal.z, 0.0));
            aux.z = floatBitsToUint(payload.hitT);
            aux.w = payload.instId;
            imageStore(auxImage, ivec2(gl_LaunchIDEXT.xy), aux);
            return;
        }
        radiance += throughput * payload.radiance;
        if ((payload.flags & kFlagContinue) == 0u)
            break;
        throughput *= payload.throughput;
        rayOrigin = payload.nextOrigin;
        rayDir = payload.nextDir;
    }

    // Accumulate (sum); the CPU divides by the sample count on readback.
    vec3 prev = imageLoad(image, ivec2(gl_LaunchIDEXT.xy)).rgb;
    imageStore(image, ivec2(gl_LaunchIDEXT.xy), vec4(prev + radiance, 1.0));
}

#version 450
// Multigrid prolongation-and-correct z += P e (GPU3): one thread per mesh
// node, u = t + omega x d from its aggregate's 6 coarse DOFs. Each free DOF
// belongs to exactly one node — no atomics.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Coarse { float ec[]; };    // 6*nAgg
layout(std430, binding = 1) readonly buffer NodeAgg { int agg[]; };
layout(std430, binding = 2) readonly buffer NodeOff { float off[]; };
layout(std430, binding = 3) readonly buffer NodeDof { int ndof[]; };
layout(std430, binding = 4) buffer VecZ { float z[]; };

layout(push_constant) uniform Push { uint nNodes; } pc;

void main() {
  const uint n = gl_GlobalInvocationID.x;
  if (n >= pc.nNodes) return;
  const int a = agg[n];
  if (a < 0) return;
  const uint c = 6u * uint(a);
  const float dx = off[3u * n + 0u], dy = off[3u * n + 1u],
              dz = off[3u * n + 2u];
  const float ux = ec[c + 0u] + ec[c + 4u] * dz - ec[c + 5u] * dy;
  const float uy = ec[c + 1u] - ec[c + 3u] * dz + ec[c + 5u] * dx;
  const float uz = ec[c + 2u] + ec[c + 3u] * dy - ec[c + 4u] * dx;
  const int gx = ndof[3u * n + 0u], gy = ndof[3u * n + 1u],
            gz = ndof[3u * n + 2u];
  if (gx >= 0) z[gx] += ux;
  if (gy >= 0) z[gy] += uy;
  if (gz >= 0) z[gz] += uz;
}

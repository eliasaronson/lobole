# Build folder
build/*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Dependencies
deps/*

# CAD files
CAD_files/*
example_projects/*

# ImGui layout (generated at runtime)
imgui.ini

# Python bytecode (tools/, tests/)
__pycache__/

# All out-of-source build dirs (build/, build-asan/, ...)
build-*/
.cache/
tests/golden/*.autosave

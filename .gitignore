# Build folder
build/*

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Dependencies
deps/*

# CAD files
CAD_files/*
example_projects/*

# ImGui layout (generated at runtime)
imgui.ini

# Python bytecode (tools/, tests/)
__pycache__/

# All out-of-source build dirs (build/, build-asan/, ...)
build-*/
.cache/
tests/golden/*.autosave

# Onshape importer working dumps (large real projects; small fixtures live in tests/fixtures/onshape)
/tools/onshape_dumps/
*.onshape-dump.json

# nix build output symlink
result
result-*

# Flatpak build state
packaging/flatpak/.flatpak-builder/
packaging/flatpak/.build/

# Personal scratch: dogfooding projects, throwaway scripts, exported meshes.
# Untracked by intent — a `git add -A` used to sweep the whole tree in
# (it once landed in a commit and had to be reset back out).
scratch/
todo.txt

# Locally built distribution artifacts (tens of MB of ELF; rebuild instead).
# An old one of these is still sitting in this clone's reflog at 619 MB.
designer-appimage
*.AppImage

# Assistant/agent working directories and their notes — machine-local
# configuration, not project source.
.codex/
.pi-subagents/
AGENTS.md

<!-- The process's ANSI code page is UTF-8 (Windows 10 1903 and later), so
     every narrow Windows API - GetModuleFileNameA, getenv, fopen, and the
     ones inside OpenCASCADE and ImGui - speaks the same encoding as
     libstdc++'s std::filesystem, which reads and writes a narrow path as
     UTF-8 on Windows. Without it a path holding a non-ASCII character
     (C:\Program Files\Loböle, a user named Åsa) arrives as Windows-1252
     and the first conversion throws (docs/packaging/README.md). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
